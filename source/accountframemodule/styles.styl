// accountframe styles
#accountframe
    width 100%
    text-align left
    padding 25px
    // padding-left 50px
    box-sizing: border-box
    max-width: 600px

    .click-button
        display block
        width 100%
        font-size 12pt
        color #fff
        // background-color #000
        background-color cd-button-dark
        border solid 2px #fff
        box-shadow: 0 0 5px #000
        padding 12px 20px
        border-radius: 10px



#migration-retrieval-form
    display none
    margin-top 20px
    
    label
        display block
        font-size 11pt
        width 100%
        text-align: left
        margin-bottom 10px
        margin-left auto
        margin-right auto
    input
        display block
        font-size 14pt
        width 100%
        border none
        outline: none
        padding 8px
        box-sizing border-box
        margin-bottom 15px
        border-bottom solid 1px transparent
        text-align left

    input:focus
        border-bottom solid 1px cd-dark-blue

    button
        display block
        width 100%
        font-size 11pt
        color #fff
        background-color cd-button-dark
        border solid 2px #fff
        box-shadow: 0 0 5px #000
        padding 10px 15px
        box-sizing border-box
        border-radius: 10px

#account-status-key-available
    color white
    background-color #1b2
    text-align: center
    padding 12px 0
    border-radius 3px
    margin 20px 0

#account-management
    margin-top 120px
    
    h2
        margin 30px 0

    input
        display: block
        font-size 12pt
        width 100%
        border none
        outline: none
        padding: 10px 
        margin-bottom 20px
        border-bottom solid 1px transparent

    input:focus
        border-bottom solid 1px cd-dark-blue

    label
        display block
        margin-bottom 5px

    button
        margin-bottom 20px
    p
        margin 20px 0
        // color #444

    #deletion-button
        background-color #512
