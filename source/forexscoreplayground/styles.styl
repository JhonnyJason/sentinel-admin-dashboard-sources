// ForexScore Playground - Grid Layout

// Indicator colors
$infl-color = #4a90d9    // blue
$mrr-color = #9b59b6    // purple
$gdp-color = #27ae60    // green
$cot-color = #f1c40f    // yellow

// Components include
@import "components/common.styl"
@import "components/cotnorm-el.styl"
@import "components/cubdiff-el.styl"
@import "components/linnorm-el.styl"
@import "components/makro-el.styl"
@import "components/quadnorm-el.styl"
@import "components/result-el.styl"

// Main grid container
#playground-grid
    display grid
    grid-template-columns 1fr 1fr 1fr
    grid-template-rows auto auto auto auto auto
    gap 20px
    margin-top 30px

// All grid cells share base styling
.grid-cell
    border-radius 5px
    box-shadow 0 0 5px #777
    background #fff

// Row 1 Column 3: Results area
#results-area
    padding 10px 0
    display flex
    flex-direction column
    gap 15px


// Rows 2-5: Normalization and Diff cells
.norm-cell
.diff-cell
    min-height 80px
    padding 10px

    .cell-header
        font-size 10pt
        font-weight bold
        color #666
        margin-bottom 10px
        padding-bottom 8px
        border-bottom 1px solid #eee

    .norm-content
        display flex
        flex-direction column
        gap 2px

    .param-row
        display flex
        justify-content space-between
        align-items center
        padding 4px 0

    .param-label
        font-size 9pt
        color #888

    .param-input
        border none
        background alpha(cd-dark-blue, 0.05)
        padding 3px 6px
        border-radius 3px
        width 50px
        text-align right
        font-size 10pt
        font-family inherit

        &::-webkit-inner-spin-button
        &::-webkit-outer-spin-button
            -webkit-appearance none
            margin 0
        &[type="number"]
            -moz-appearance textfield

        &:focus
            outline none
            box-shadow 0 0 2px cd-dark-blue

    .param-display
        font-size 10pt
        font-weight bold
        padding 3px 6px
        border-radius 3px

    .raw-value
        color cd-dark-blue
        background alpha(cd-dark-blue, 0.08)

    .zero-range
        font-size 9pt
        color #666

    .feedback-row
        border-top 1px dashed #eee
        margin-top 4px
        padding-top 6px

    .result-display
        margin-top 10px
        padding 8px
        border-radius 4px
        text-align center
        font-weight bold
        font-size 12pt

    .norm-result
        margin-top 8px

// Indicator-specific colors for norm/diff cells
#infl-norm-base
#infl-norm-quote
#infl-diff
    .cell-header
        color $infl-color
    .result-display
        background alpha($infl-color, 0.15)
        color darken($infl-color, 20%)

#mrr-norm-base
#mrr-norm-quote
#mrr-diff
    .cell-header
        color $mrr-color
    .result-display
        background alpha($mrr-color, 0.15)
        color darken($mrr-color, 20%)

#gdp-norm-base
#gdp-norm-quote
#gdp-diff
    .cell-header
        color $gdp-color
    .result-display
        background alpha($gdp-color, 0.15)
        color darken($gdp-color, 20%)

#cot-norm-base
#cot-norm-quote
#cot-diff
    .cell-header
        color $cot-color
    .result-display
        background alpha($cot-color, 0.15)
        color darken($cot-color, 20%)
