// ForexScore Playground - Grid Layout

// Components include (common.styl defines indicator color vars)
@import "components/common.styl"
@import "components/makro-el.styl"
@import "components/result-el.styl"

// Main grid container
#playground-grid
    display grid
    grid-template-columns 1fr 1fr 1fr
    grid-template-rows auto auto auto auto auto auto
    gap 20px
    margin-top 30px

// All grid cells share base styling
.grid-cell
    border-radius 5px
    box-shadow 0 0 5px #777
    background #fff

// Row 1 Column 1-2: Focus pair selection
#focuspair-cell
    grid-column span 2
    border none
    box-shadow: none

// Row 1-2 Column 3: Results area (spans focuspair row + area data row)
#results-area
    grid-row span 2
    padding 10px 0
    display flex
    flex-direction column
    gap 15px
