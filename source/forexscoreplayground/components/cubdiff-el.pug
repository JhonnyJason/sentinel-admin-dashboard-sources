//- Cubic diff curve cell
//- Handle: DiffHandle
.cell-header
    h2
        span Diff 
        span.diff-type-title
.diff-content
    .diff-equation
        span.eq-label f(
        span.diff-base-val --
        span.eq-op  -
        span.diff-quote-val --
        span.eq-label ) = 
        span.coeff.coeff-b --
        span.eq-op ·x + 
        span.coeff.coeff-d --
        span.eq-op ·x
        sup 3
        span.eq-label  = 
        span.diff-result --
    .param-row
        span.param-label b
        input.param-input.b-input(type="number" step="0.1")
    .param-row
        span.param-label d
        input.param-input.d-input(type="number" step="0.01")
