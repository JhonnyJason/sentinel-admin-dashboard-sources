// Row 1: Economic area cards (taller)
.economic-area
    padding 15px
    min-height 200px

    .area-top
        display flex
        align-items center
        margin-bottom 20px
        padding-bottom 15px
        border-bottom 1px solid #eee

    .area-flag
        width 50px
        height 50px
        svg
            width 100%
            height 100%

    .area-title
        font-size 14pt
        font-weight bold
        margin-left 15px
        flex 1

    .area-currency
        font-size 12pt
        font-weight bold
        color cd-dark-blue
        background alpha(cd-dark-blue, 0.1)
        padding 5px 10px
        border-radius 3px

    .data-row
        display flex
        justify-content space-between
        align-items center
        padding 8px 0
        border-bottom 1px solid #f0f0f0

    .data-row:last-child
        border-bottom none

    .data-label
        color #666
    
    .data-color
        width 20px
        height 20px
        border-radius 50%
        margin-right auto
        margin-left 5px

    .infl-data .data-color
        background-color $infl-color

    .mrr-data .data-color
        background-color $mrr-color

    .gdpg-data .data-color
        background-color $gdp-color

    .cot6-data .data-color
    .cot36-data .data-color
        background-color $cot-color

    .data-value
        font-weight bold
        color cd-dark-blue

    .data-input
        border none
        background transparent
        font-weight bold
        color cd-dark-blue
        text-align right
        width 40px
        padding 0
        font-size inherit
        font-family inherit

        &::-webkit-inner-spin-button
        &::-webkit-outer-spin-button
            -webkit-appearance none
            margin 0
        &[type="number"]
            -moz-appearance textfield

        &:focus
            outline none

        &.modified
            color rgb(213, 128, 42)

    .reset-button
        display block
        margin-top 15px
        margin-left auto
        padding 5px 10px
        border-radius 3px
        background alpha(cd-dark-blue, 0.1)
        font-size 13pt
        cursor pointer
        opacity 0
        pointer-events none
        transition opacity 0.2s

        &.visible
            opacity 1
            pointer-events auto

        &:hover
            background alpha(#f90, 0.35)

    .strong
        color #33cc00

    .weak
        color #cc3300
