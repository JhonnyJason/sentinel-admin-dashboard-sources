//- COT normalization cell
//- Handle: CotNormHandle
.cell-header
    h2
        svg: use.header-flag(href="")
        span Normierung 
        span.norm-type-title
.norm-content
    .hint
        p Die Normierung bringt den Wert in den Bereich [0, 2]. 

    .norm-display
        span norm(  
        span.raw-value.cot6-value --
        span , 
        span.raw-value.cot36-value --
        span  ) =  
        span.norm-result --


    .param-row
        span.param-label Neutraler COT
        span.param-value-wrap
            input.param-input.n-input(type="number" step="1" min="0" max="100")
            span.param-unit  %
    .param-row
        span.param-label COT36 Gewicht (vs COT6)
        input.param-input.e-input(type="number" step="0.01" min="1.0" max="3.0")
    .cell-buttons
        .default-button Auf Standardwerte Zurücksetzen
        .reset-button Reset