//- COT normalization cell
//- Handle: CotNormHandle
.cell-header
.norm-content
    .param-row
        span.param-label F-Faktor
        input.param-input.f-input(type="number" step="0.1")
    .cot-values
        .cot-row
            span.cot-label 6m:
            span.raw-value.cot6-value --
        .cot-row
            span.cot-label 36m:
            span.raw-value.cot36-value --
    .norm-equation
        span.eq-label cot(
        span.raw-value --
        span.eq-label ) =
        span.norm-result --
