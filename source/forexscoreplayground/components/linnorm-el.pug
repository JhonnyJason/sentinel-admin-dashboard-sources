//- Linear normalization cell (Interest/MRR)
//- Handle: LinNormHandle
.cell-header
    h2
        svg: use.header-flag(href="")
        span Normierung 
        span.norm-type-title
.norm-content
    .norm-equation
        span.eq-label n(
        span.raw-value --
        span.eq-label ) = 
        span.coeff.coeff-a --
        span.eq-op  + 
        span.coeff.coeff-b --
        span.eq-op ·x
        span.eq-label  = 
        span.norm-result --
    .param-row
        span.param-label Neutralrate
        span.param-value-wrap
            input.param-input.neutral-input(type="number" step="0.1")
            span.param-unit %
    .param-row
        span.param-label Sensitivität
        input.param-input.sensitivity-input(type="number" step="0.1")
