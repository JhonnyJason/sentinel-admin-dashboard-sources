//- Linear normalization cell (Interest/MRR)
//- Handle: LinNormHandle
.cell-header
.norm-content
    .param-row
        span.param-label Neutralrate
        span.param-value-wrap
            input.param-input.neutral-input(type="number" step="0.1")
            span.param-unit %
    .param-row
        span.param-label Sensitivität
        input.param-input.sensitivity-input(type="number" step="0.1")
    .norm-equation
        span.eq-label n(
        span.raw-value --
        span.eq-label ) =
        span.norm-result --
