//- Special Linear normalization cell (Interest/MRR)
//- Handle: MrrNormHandle
.cell-header
    h2
        svg: use.header-flag(href="")
        span Normierung 
        span.norm-type-title
.norm-content
    .hint
        p Die Normierung bringt den Wert in den Bereich [0, 2]. 

    .norm-display
        span norm(  
        span.raw-value --
        span  ) =  
        span.norm-result --

    .param-row
        span.param-label Minimalrate (wird zu 0)
        span.param-value-wrap
            input.param-input.floor-input(type="number" step="0.1")
            span.param-unit  %

    .param-row
        span.param-label Neutralrate (wird zu 1)
        span.param-value-wrap
            input.param-input.neutral-input(type="number" step="0.1")
            span.param-unit  %
    .param-row
        span.param-label Maximalrate (wird zu 2)
        span.param-value-wrap
            input.param-input.ceiling-input(type="number" step="0.1")
            span.param-unit  %

    .param-row
        span.param-label Inflationseinfluss
        span.param-value-wrap
            //- span.param-unit min
            input.param-input.infl-punishment-input(type="range" min="0" max="100" step="0.5")
            //- span.param-unit max
    .cell-buttons
        .default-button Auf Standardwerte Zurücksetzen
        .reset-button Reset
