//- Quadratic normalization cell (Inflation, GDP)
//- Handle: QuadNormHandle
.cell-header
    h2 
        svg: use.header-flag(href="")
        span Normierung 
        span.norm-type-title
.norm-content

    .hint
        p Die Normierung bringt den Wert in den Bereich [0, 2].

    .norm-display
        span norm(  
        span.raw-value --
        span  ) =  
        span.norm-result --
        
    .param-row
        span.param-label Höchstwert bei
        span.param-value-wrap
            input.param-input.peak-input(type="number" step="0.1")
            span.param-unit  %
    .param-row
        span.param-label Steilheit der Kurve
        input.param-input.steepness-input(type="range" step="0.01" min="0.10" max="5.00")
    .param-row.feedback-row
        span.param-label Nullwerte
        span.param-display.zero-range
            span.zero-low --
            |  % und 
            span.zero-high --
            |  %
