// tablerender styles
.table-renderer-table
    width: 100%
    border-collapse: collapse
    font-size 9pt
    border-radius: 3px

    th, td
        padding 8px 20px
        box-sizing: border-box
        overflow hidden
        text-overflow: ellipsis

    td, tr
        border-left solid 1px alpha(#fff, 0.1)
    tr
        border-right solid 1px alpha(#fff, 0.1)
    th
        background-color rgba(255, 255, 255, 0.1)
        border-bottom 2px solid rgba(255, 255, 255, 0.2)
        text-align left

    th.sortable
        cursor pointer
        user-select none
        position relative
        padding-right 20px
        box-sizing: border-box

        &:hover
            background-color alpha(#fff, 0.2)

        &::after
            content ""
            position absolute
            right 7px
            top 50%
            transform translateY(-50%)
            border 4px solid transparent
            opacity 0.3

        &.sorted::after
            opacity 1
            border-top-color #fff
            margin-top 4px

        &.asc::after
            border-top none
            border-bottom-color #fff
            margin-top -4px


    tbody tr
        border-bottom 1px solid rgba(255, 255, 255, 0.1)

    tbody tr:nth-child(2n)
        background-color alpha(#fff, 0.05)

    tbody tr:hover
        background-color alpha(#fff, 0.2)

    tbody tr.chosen
        background-color alpha(#abf, 0.2)





    
    
 