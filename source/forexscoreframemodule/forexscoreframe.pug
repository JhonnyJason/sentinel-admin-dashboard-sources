//- forexscore structure
#forexscoreframe
    #selection-row
        .combobox-wrapper
            input#pair-input(type="text" placeholder="Pair suchen..." autocomplete="off")
            .combobox-dropdown#pair-dropdown
        #selected-pair

    //- Main grid: 3 columns x 5 rows
    #focus-pair-grid
        //- Row 1: Area data + Results
        #base-area.economic-area.grid-cell
        #quote-area.economic-area.grid-cell
        #results-area.grid-cell
            //- Each result box: label, colored score, equation breakdown
            //- Equation structure: weight × score + weight × score + ... = result
            //- Design: colored background = readonly constant (indicates origin)
            //-         no background = editable input field
            .result-box#result-st
                .result-label Short-Term
                .result-equation
                    span.eq-term.inf
                        input.weight-input(type="number" data-horizon="st" data-indicator="i")
                        span.eq-mult ×
                        span.eq-score --
                    span.eq-op +
                    span.eq-term.mrr
                        input.weight-input(type="number" data-horizon="st" data-indicator="l")
                        span.eq-mult ×
                        span.eq-score --
                    span.eq-op +
                    span.eq-term.gdp
                        input.weight-input(type="number" data-horizon="st" data-indicator="g")
                        span.eq-mult ×
                        span.eq-score --
                    span.eq-op +
                    span.eq-term.cot
                        input.weight-input(type="number" data-horizon="st" data-indicator="c")
                        span.eq-mult ×
                        span.eq-score --
                    span.eq-op =
                    span.eq-result --
                .scoring-result
                    .inner-frame
                        .result-score --
                    .trend-text --

            .result-box#result-mlt
                .result-label Mid/Long-Term
                .result-equation
                    span.eq-term.inf
                        input.weight-input(type="number" data-horizon="mlt" data-indicator="i")
                        span.eq-mult ×
                        span.eq-score --
                    span.eq-op +
                    span.eq-term.mrr
                        input.weight-input(type="number" data-horizon="mlt" data-indicator="l")
                        span.eq-mult ×
                        span.eq-score --
                    span.eq-op +
                    span.eq-term.gdp
                        input.weight-input(type="number" data-horizon="mlt" data-indicator="g")
                        span.eq-mult ×
                        span.eq-score --
                    span.eq-op +
                    span.eq-term.cot
                        input.weight-input(type="number" data-horizon="mlt" data-indicator="c")
                        span.eq-mult ×
                        span.eq-score --
                    span.eq-op =
                    span.eq-result --
                .scoring-result
                    .inner-frame
                        .result-score --
                    .trend-text --

            .result-box#result-lt
                .result-label Long-Term
                .result-equation
                    span.eq-term.inf
                        input.weight-input(type="number" data-horizon="lt" data-indicator="i")
                        span.eq-mult ×
                        span.eq-score --
                    span.eq-op +
                    span.eq-term.mrr
                        input.weight-input(type="number" data-horizon="lt" data-indicator="l")
                        span.eq-mult ×
                        span.eq-score --
                    span.eq-op +
                    span.eq-term.gdp
                        input.weight-input(type="number" data-horizon="lt" data-indicator="g")
                        span.eq-mult ×
                        span.eq-score --
                    span.eq-op +
                    span.eq-term.cot
                        input.weight-input(type="number" data-horizon="lt" data-indicator="c")
                        span.eq-mult ×
                        span.eq-score --
                    span.eq-op =
                    span.eq-result --
                .scoring-result
                    .inner-frame
                        .result-score --
                    .trend-text --

        //- Row 2: Inflation normalization + diff
        #inf-norm-base.norm-cell.grid-cell
        #inf-norm-quote.norm-cell.grid-cell
        #inf-diff.diff-cell.grid-cell

        //- Row 3: Interest (MRR) normalization + diff
        #mrr-norm-base.norm-cell.grid-cell
        #mrr-norm-quote.norm-cell.grid-cell
        #mrr-diff.diff-cell.grid-cell

        //- Row 4: GDP normalization + diff
        #gdp-norm-base.norm-cell.grid-cell
        #gdp-norm-quote.norm-cell.grid-cell
        #gdp-diff.diff-cell.grid-cell

        //- Row 5: COT normalization + diff
        #cot-norm-base.norm-cell.grid-cell
        #cot-norm-quote.norm-cell.grid-cell
        #cot-diff.diff-cell.grid-cell
