// Focus Pair Display - Grid Layout

// Indicator colors
$inf-color = #4a90d9    // blue
$mrr-color = #9b59b6    // purple
$gdp-color = #27ae60    // green
$cot-color = #f1c40f    // yellow

// Main grid container
#focus-pair-grid
    display grid
    grid-template-columns 1fr 1fr 1fr
    grid-template-rows auto auto auto auto auto
    gap 20px
    margin-top 30px

// All grid cells share base styling
.grid-cell
    border-radius 5px
    box-shadow 0 0 5px #777
    background #fff

// Row 1: Economic area cards (taller)
.economic-area
    padding 15px
    min-height 200px

    .area-top
        display flex
        align-items center
        margin-bottom 20px
        padding-bottom 15px
        border-bottom 1px solid #eee

    .area-flag
        width 50px
        height 50px
        svg
            width 100%
            height 100%

    .area-title
        font-size 14pt
        font-weight bold
        margin-left 15px
        flex 1

    .area-currency
        font-size 12pt
        font-weight bold
        color cd-dark-blue
        background alpha(cd-dark-blue, 0.1)
        padding 5px 10px
        border-radius 3px

    .data-row
        display flex
        justify-content space-between
        align-items center
        padding 8px 0
        border-bottom 1px solid #f0f0f0

    .data-row:last-child
        border-bottom none

    .data-label
        color #666

    .data-value
        font-weight bold
        color cd-dark-blue

    .data-input
        border none
        background transparent
        font-weight bold
        color cd-dark-blue
        text-align right
        width 40px
        padding 0
        font-size inherit
        font-family inherit

        &::-webkit-inner-spin-button
        &::-webkit-outer-spin-button
            -webkit-appearance none
            margin 0
        &[type="number"]
            -moz-appearance textfield

        &:focus
            outline none

        &.modified
            color rgb(213, 128, 42)

        &.cot-input
            width 30px

    .reset-button
        display block
        margin-top 15px
        margin-left auto
        padding 5px 10px
        border-radius 3px
        background alpha(cd-dark-blue, 0.1)
        font-size 13pt
        cursor pointer
        opacity 0
        pointer-events none
        transition opacity 0.2s

        &.visible
            opacity 1
            pointer-events auto

        &:hover
            background alpha(#f90, 0.35)

    .cot-values
        display flex
        align-items center

    .cot-separator
        color #999
        padding 0 5px

    .strong
        color #33cc00

    .weak
        color #cc3300

// Row 1 Column 3: Results area
#results-area
    padding 10px 0
    display flex
    flex-direction column
    gap 15px

    .result-box
        flex 1
        padding 12px 0
        text-align center
        display flex
        flex-direction column
        border-top solid 1px #ddd

        .result-label
            font-size 10pt
            color #555
            font-weight bold
            margin-bottom 5px

        .scoring-result
            display flex
            align-items: center
            padding 0 40px

        .inner-frame
            background-color #eeeeee99
            padding 20px

        .trend-text
            margin-left 20px
            font-size 14pt
            font-weight bold

        .result-score
            font-size 22pt
            font-weight bold

        .result-equation
            padding 0 3px
            display flex
            align-items center
            justify-content space-between
            margin-bottom 5px
            font-size 10pt

        .eq-term
            display inline-flex
            align-items center
            gap 2px

        // Editable weight inputs (no background = editable)
        .weight-input
            width 28px
            border none
            background transparent
            font-weight bold
            text-align center
            font-size 13pt
            font-family inherit
            padding 0
            color cd-dark-blue

            &::-webkit-inner-spin-button
            &::-webkit-outer-spin-button
                -webkit-appearance none
                margin 0
            &[type="number"]
                -moz-appearance textfield

            &:focus
                outline none

        .eq-mult
            color #888

        // Score constants: colored background = readonly (not editable)
        // Color indicates which indicator the value comes from
        .eq-score
            font-weight bold
            padding 2px 4px
            border-radius 3px

        .eq-term.inf .eq-score
            background alpha($inf-color, 0.2)
            color darken($inf-color, 20%)

        .eq-term.mrr .eq-score
            background alpha($mrr-color, 0.2)
            color darken($mrr-color, 20%)

        .eq-term.gdp .eq-score
            background alpha($gdp-color, 0.2)
            color darken($gdp-color, 20%)

        .eq-term.cot .eq-score
            background alpha($cot-color, 0.2)
            color darken($cot-color, 20%)

        .eq-op
            color #888
            font-weight bold

        .eq-result
            font-weight bold
            color cd-dark-blue
            padding 2px 6px
            background alpha(cd-dark-blue, 0.1)
            border-radius 3px

// Rows 2-5: Normalization and Diff cells
.norm-cell
.diff-cell
    min-height 80px
    padding 10px

    .cell-header
        font-size 10pt
        font-weight bold
        color #666
        margin-bottom 10px
        padding-bottom 8px
        border-bottom 1px solid #eee

    .norm-content
        display flex
        flex-direction column
        gap 2px

    .param-row
        display flex
        justify-content space-between
        align-items center
        padding 4px 0

    .param-label
        font-size 9pt
        color #888

    .param-input
        border none
        background alpha(cd-dark-blue, 0.05)
        padding 3px 6px
        border-radius 3px
        width 50px
        text-align right
        font-size 10pt
        font-family inherit

        &::-webkit-inner-spin-button
        &::-webkit-outer-spin-button
            -webkit-appearance none
            margin 0
        &[type="number"]
            -moz-appearance textfield

        &:focus
            outline none
            box-shadow 0 0 2px cd-dark-blue

    .param-display
        font-size 10pt
        font-weight bold
        padding 3px 6px
        border-radius 3px

    .raw-value
        color cd-dark-blue
        background alpha(cd-dark-blue, 0.08)

    .zero-range
        font-size 9pt
        color #666

    .feedback-row
        border-top 1px dashed #eee
        margin-top 4px
        padding-top 6px

    .result-display
        margin-top 10px
        padding 8px
        border-radius 4px
        text-align center
        font-weight bold
        font-size 12pt

    .norm-result
        margin-top 8px

// Indicator-specific colors for norm/diff cells
#inf-norm-base
#inf-norm-quote
#inf-diff
    .cell-header
        color $inf-color
    .result-display
        background alpha($inf-color, 0.15)
        color darken($inf-color, 20%)

#mrr-norm-base
#mrr-norm-quote
#mrr-diff
    .cell-header
        color $mrr-color
    .result-display
        background alpha($mrr-color, 0.15)
        color darken($mrr-color, 20%)

#gdp-norm-base
#gdp-norm-quote
#gdp-diff
    .cell-header
        color $gdp-color
    .result-display
        background alpha($gdp-color, 0.15)
        color darken($gdp-color, 20%)

#cot-norm-base
#cot-norm-quote
#cot-diff
    .cell-header
        color $cot-color
    .result-display
        background alpha($cot-color, 0.15)
        color darken($cot-color, 20%)
