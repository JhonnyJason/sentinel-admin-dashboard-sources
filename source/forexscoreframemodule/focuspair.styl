// Focus Pair Display
#focus-pair
    display flex
    gap 30px
    margin-top 30px

    .economic-area
        flex 1
        max-width 350px
        padding 20px
        border-radius 5px
        box-shadow 0 0 5px #777
        background #fff

    .area-top
        display flex
        align-items center
        margin-bottom 20px
        padding-bottom 15px
        border-bottom 1px solid #eee

    .area-flag
        width 50px
        height 50px
        svg
            width 100%
            height 100%

    .area-title
        font-size 14pt
        font-weight bold
        margin-left 15px
        flex 1

    .area-currency
        font-size 12pt
        font-weight bold
        color cd-dark-blue
        background alpha(cd-dark-blue, 0.1)
        padding 5px 10px
        border-radius 3px

    .data-row
        display flex
        justify-content space-between
        align-items center
        padding 8px 0
        border-bottom 1px solid #f0f0f0

    .data-row:last-child
        border-bottom none

    .data-label
        color #666

    .data-value
        font-weight bold
        color cd-dark-blue

    .data-input
        border none
        background transparent
        font-weight bold
        color cd-dark-blue
        text-align right
        width 40px
        padding 0
        font-size inherit
        font-family inherit

        // Hide number input spinners
        &::-webkit-inner-spin-button
        &::-webkit-outer-spin-button
            -webkit-appearance none
            margin 0
        &[type="number"]
            -moz-appearance textfield

        &:focus
            outline none

        &.modified
            color rgb(213, 128, 42)

        &.cot-input
            width 30px

    .reset-button
        display block
        margin-top 15px
        margin-left auto
        padding 5px 10px
        // border solid 2px #fff
        border-radius 3px
        background alpha(cd-dark-blue, 0.1)
        // box-shadow: 0 0 5px #000
        // color #fff
        font-size 13pt
        cursor pointer
        opacity 0
        pointer-events none
        transition opacity 0.2s

        &.visible
            opacity 1
            pointer-events auto

        &:hover
            background alpha(#f90, 0.35)

    .cot-values
        display flex
        align-items center

    .cot-separator
        color #999
        padding 0 5px

    .strong
        color #33cc00

    .weak
        color #cc3300
