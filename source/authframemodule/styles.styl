// authframe styles
#authframe
    display none
    width 100%
    min-height 100vh
    position: relative
    padding-top: header-height
    box-sizing: border-box

// All Elements hidden by default
#authframe-inaccessible
    display: none

#authframe-pin-request
    display: none

#qr-input-frame
    display none

// specific states of visibility
#authframe.inaccessible
    display block
    background-color #fff
    z-index 101
    padding 0
    #authframe-inaccessible
        display: block

#authframe.request-pin
    display block
    #authframe-pin-request
        display: block



// Styles of the Components
#authframe-inaccessible
    width 500px
    background-color #ddd
    padding 50px
    border-radius 3px
    h2
        font-size: 28pt
        line-height 100%
        color cd-danger-red
        font-weight: bold

#authframe-pin-request
    label
        display block
        font-size 16pt
        width 100%
        text-align: center
        margin-bottom 23px
        margin-left auto
        margin-right auto
    input
        display block
        font-size 22pt
        width 100%
        border none
        outline: none
        padding: 10px 
        box-sizing: border-box
        margin-bottom 23px
        border-bottom solid 1px transparent
        text-align: center

    input:focus
        border-bottom solid 1px cd-dark-blue
        text-align: center

    button
        display block
        margin-left auto
        margin-right auto
        width 100%
        font-size 14pt
        color #fff
        // background-color #000
        background-color cd-button-dark
        border solid 2px #fff
        box-shadow: 0 0 5px #000
        padding 12px 20px
        box-sizing: border-box
        border-radius: 10px


.centered-box
    position: absolute
    top 50%
    left 50%
    transform translate(-50%, -50%)
