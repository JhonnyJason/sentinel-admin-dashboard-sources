// forexscoreversion styles
#forexscore-version-row
    width 100%
    min-height 20px
    background-color rgba(0, 0, 0, 0.2)
    display flex
    align-items center
    gap 10px
    padding 8px 12px
    box-sizing border-box

#forexscore-version-row input,
#forexscore-version-row select
    padding 8px 10px
    border-radius 3px
    border solid 1px cd-dark-blue
    font-size 12pt
    background #fff
    box-sizing border-box

#forexscore-version-row input:focus,
#forexscore-version-row select:focus
    outline none
    box-shadow 0 0 3px 0 cd-dark-blue

#forexscore-version-row .click-button
    padding 8px 14px
    border-radius 3px
    border solid 1px cd-dark-blue
    font-size 12pt
    background cd-dark-blue
    color #fff
    white-space nowrap