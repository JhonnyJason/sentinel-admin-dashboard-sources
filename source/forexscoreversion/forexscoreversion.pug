//- forexscoreversion structure
#forexscore-version-row
    .group
        button#save-button.click-button Speichern 
        #forexscore-version-naming
            input#playground-name-input(placeholder="Name der Spielwiese")
            select#playground-version-select

        button#publish-button.click-button Publizieren
        button#reset-button.click-button(hidden) Reset
    
    .group
        select#open-select
            option(value="" disabled selected) Spielwiese öffnen
        button#create-copy-button.click-button Spielwiese kopieren 
        button#create-new-button.click-button Neue Spielwiese
    
    