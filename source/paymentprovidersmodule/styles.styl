// usermanagement styles
cd-positive = #1b2
cd-negative = #c21
cd-attention = #ca3

#paymentprovidersframe
    width 100%
    text-align left
    padding 25px
    // padding-left 50px
    box-sizing: border-box
    max-width: 600px
    h1
        margin-bottom: 20px

    .click-button
        display none
        width 100%
        font-size 12pt
        color #fff
        // background-color #000
        border solid 2px #fff
        box-shadow: 0 0 5px #000
        padding 12px 20px
        border-radius: 10px
        margin 20px 0

    input
        display: block
        font-size 12pt
        width 100%
        border none
        outline: none
        padding: 10px 
        margin-bottom 20px
        border-bottom solid 1px transparent

    input:focus
        border-bottom solid 1px cd-dark-blue

    #no-account-form
        display none
        .click-button
            display block

#account-email-input
    margin-top 50px

#stripe-connected-status
#stripe-connected-status-onboarded
#stripe-connected-verified
#stripe-connecting-status
#stripe-connected-verifying
#stripe-connecting-status-not
#stripe-not-connected-status
#stripe-connected-not-verified
    display none
    color white
    text-align: center
    padding 12px 0
    border-radius 3px


#stripe-connected-status
#stripe-connected-status-onboarded
#stripe-connected-verified
    background-color cd-positive

#stripe-connecting-status
#stripe-connected-verifying
    background-color cd-attention

#stripe-connecting-status-not
#stripe-not-connected-status
#stripe-connected-not-verified
    background-color: cd-negative

#stripe-connect-button
#stripe-onboard-button
#stripe-update-button
#stripe-continue-button
    background-color cd-button-dark

#stripe-dashboard-button
    // background-color cd-flash
    background-color cd-info
    // background-color #228
    margin-bottom 50px !important



#stripe-management.not-connected
    #no-account-form
        display block
    #stripe-not-connected-status
        display block


// #stripe-management.connecting-not

#stripe-management.connecting
    #stripe-continue-button
        display block
    #stripe-connecting-status
        display block

#stripe-management.connected
    #stripe-dashboard-button
        display block
    #stripe-update-button
        display block
    #stripe-connected-status
        display block


.disabled
    filter grayscale(100%)
    opacity 0.5
    pointer-events: none