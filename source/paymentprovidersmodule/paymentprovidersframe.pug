//- usermanagement structure
#paymentprovidersframe
    //- section#stripe-management.not-connected
    //- section#stripe-management.connected
    section#stripe-management
        h1 Stripe

        #stripe-not-connected-status Kein Konto verbunden
        #stripe-connected-status Stripe Konto verbunden
        #stripe-connecting-status-not Nicht onboarded
        #stripe-connecting-status Onboarding gestartet...
        #stripe-connected-status-onboarded Onboarding abgeschlossen
        #stripe-connected-verifying Wird verifiziert
        #stripe-connected-not-verified Verifizierung fehlgeschlagen
        #stripe-connected-verified Verifiziert
                
        form#no-account-form
            input#account-email-input(type="email" placeholder="Email für Account..." autocomplete="email" required)
            button#stripe-connect-button.click-button Stripe Konto Verbinden / Eröffnen
        
        button#stripe-dashboard-button.click-button Zum Stripe Dashboard
        button#stripe-onboard-button.click-button Stripe Onboarding starten
        button#stripe-update-button.click-button Stripe Konto Update
        button#stripe-continue-button.click-button Oboarding fortsetzen
