// usermanagement styles
#usermanagementframe
    padding 25px
    h2
        font-size: 21pt
        font-weight: bold
        margin 50px 0 20px 0
        text-align left

#usersummary
    display: grid
    grid-auto-flow: column
    gap 30px

    .summary-stats
        border solid 1px cd-dark-blue
        color cd-dark-blue
        padding 20px
        border-radius: 10px
        box-sizing: border-box
        max-width: 280px
        .stats-label
            text-align: left
            font-size 11pt
            margin-bottom 10px
        .stats-value
            text-align: right
            font-size: 21pt
            font-weight: bold

#singleuser-head
    margin 50px 0 20px 0
    display flex
    justify-content: space-between
    align-items: center
    
    #selected-user-email
        font-size: 19pt
        font-weight: bold
        margin-right 10px

    #user-select-container
        // min-width 600px
        min-width 420px

#singleuser-row
    display flex
    flex-direction: column
    padding 40px 20px
    border solid 1px cd-dark-blue
    border-radius: 10px
    box-sizing: border-box
    min-height 420px
    width 100%

    .click-button
        display block
        width 100%
        font-size 12pt
        color #fff
        // background-color #000
        background-color cd-button-dark
        border solid 2px #fff
        box-shadow: 0 0 5px #000
        padding 12px 20px
        border-radius: 10px

#user-details-container
    flex 1 1 auto

    // display grid
    // grid-template-columns: repeat(auto-fill, minmax(120px, max-content))
    display flex
    flex-wrap wrap

    align-items: baseline
    gap 20px
    margin-bottom 30px
    box-sizing: border-box

    .user-detail
        padding 20px
        white-space nowrap
        box-sizing: border-box
        width fit-content
        display flex
        flex-direction: column

        .user-detail-label
            font-size 10pt
            text-align left
            // opacity 0.8
            color #666
        
        .user-detail-value
            text-align left
            // padding-left 5px
            padding-top 5px

#user-action-buttons-container
    flex 0 0 auto
    #user-delete-button
        background-color #512


#allusers-table-container
    padding 40px 20px
    background-color cd-dark-blue
    color #fff
    border-radius: 3px