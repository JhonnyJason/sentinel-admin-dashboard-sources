//- usermanagement structure
#usermanagementframe

    #usersummary 
        #user-registered-count.summary-stats 
            .stats-label Registrierte Benutzer 
            .stats-value X

        #users-active-count.summary-stats 
            .stats-label Aktive Benutzer (2w) 
            .stats-value X

        #users-subscribed-count.summary-stats 
            .stats-label Bezahlende Benutzer 
            .stats-value X
    #singleuser-head
        #user-select-container 
        #selected-user-email 
        button#deselect-user-button.click-button: svg: use(href="#svg-cross-icon")


    #singleuser-row
        template#user-detail-template 
            .user-detail
                .user-detail-label  
                .user-detail-value

        #no-user-content 
            #no-user-message Kein Benutzer gewählt

        #user-details-container
        #user-edit-container
            #user-edit-badge
                label(for="user-edit-badge-input") VIP Badge:
                input#user-edit-badge-input(type="text")
            #user-edit-freeaccess
                label(for="user-edit-freeaccess-input") freeAccessUntil:
                input#user-edit-freeaccess-input(type="date")
            #user-edit-tester 
                label(for="user-edit-tester-input") Tester:
                input#user-edit-tester-input(type="checkbox")

        #user-action-buttons-container
            button#user-update-button.click-button Speichern
            button#user-delete-button.click-button Benutzer entfernen


    h2 Alle Benutzer

    #allusers-table-container
        table#allusers

